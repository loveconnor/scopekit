# Postgres (one database for everything in v1)
DATABASE_URL=postgres://localhost:5432/scopekit
# Redis for the BullMQ ingest queue and collector rate limits
REDIS_URL=redis://localhost:6379

# Dashboard auth. Only these emails can sign in; there is no public signup.
SCOPEKIT_ALLOWED_EMAILS=you@example.com
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth sign-in. Without these, sign-in uses an emailed link
# (printed to the web server log when RESEND_API_KEY is unset).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
SCOPEKIT_EMAIL_FROM=

# Search Console (optional). Create an OAuth client of type "Web application" in the Google
# Cloud console, enable the Search Console API, and register this redirect URI:
#   <BETTER_AUTH_URL>/api/integrations/google/callback
# Only the read-only scope webmasters.readonly is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32-byte key that encrypts Google tokens at rest: `openssl rand -hex 32`.
# Losing it means every Google account has to be reconnected. The app and the worker need the same value.
SCOPEKIT_ENCRYPTION_KEY=
# Hours between daily syncs, and the pause between Google requests in milliseconds
GSC_SYNC_INTERVAL_HOURS=24
GSC_REQUEST_DELAY_MS=150

# Performance (optional). One Google API key with the PageSpeed Insights API and the
# Chrome UX Report API enabled. Without it the Performance screen says it is not set up.
GOOGLE_API_KEY=
# Where alert emails go (critical alerts, and rules you opt in per site). Defaults to the
# first allowed email. Needs RESEND_API_KEY and SCOPEKIT_EMAIL_FROM above.
SCOPEKIT_ALERT_EMAIL=
# Pause between crawler requests in milliseconds (500 = two requests a second)
CRAWLER_MIN_INTERVAL_MS=500

# Public collector origin, shown in the install snippet
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:8787
COLLECTOR_PORT=8787
# Header that carries the visitor country when the collector sits behind a CDN
# (for example cf-ipcountry or x-vercel-ip-country). Empty disables country.
COLLECTOR_COUNTRY_HEADER=
# Number of trusted proxies in front of the collector (0 = use the socket address)
COLLECTOR_TRUSTED_PROXIES=0

# Show synthetic demo sites created by `npm run demo:seed`
SCOPEKIT_DEMO=0
